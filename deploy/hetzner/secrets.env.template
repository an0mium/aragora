# Copy to secrets.env on the host, fill in, then: chmod 600 secrets.env
# secrets.env is gitignored. Never commit it, never paste it into chat or a PR.
#
# Every value here is NEW. The AWS Secrets Manager copies are unrecoverable and
# should be treated as compromised regardless — rotate at the provider, do not
# try to reuse an old value.

# --- database / cache (invent these; they are new) -------------------------
POSTGRES_DB=aragora
POSTGRES_USER=aragora
POSTGRES_PASSWORD=            # openssl rand -base64 32

# --- API access ------------------------------------------------------------
ARAGORA_API_TOKEN=            # openssl rand -hex 32

# --- model providers (regenerate in each provider console) ------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=           # optional but recommended: quota fallback

# --- optional ---------------------------------------------------------------
# GEMINI_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
