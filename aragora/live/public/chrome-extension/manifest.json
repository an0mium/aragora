{
  "manifest_version": 3,
  "name": "Aragora Adversarial Review",
  "description": "Run Aragora gauntlet reviews against selected text and inspect the latest findings from the extension popup.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://api.aragora.ai/*",
    "https://*.aragora.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "popup.js"
  },
  "action": {
    "default_title": "Aragora Review",
    "default_popup": "popup.html"
  }
}
